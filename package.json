{
  "name": "aperture-hours",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:candidate": "node scripts/audit-candidate.mjs",
    "audit:reports": "node scripts/collect-audits.mjs",
    "audit:plan": "node scripts/audit-plan.mjs",
    "audit:release-clean": "node scripts/check-release-clean.mjs",
    "audit:deps": "pnpm audit --prod",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@upstash/redis": "1.38.4",
    "@vercel/blob": "2.6.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@10.6.0"
}
