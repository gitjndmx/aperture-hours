# Local deterministic adapter. Never enable in production.
USE_MEMORY_STORE=1
# Deterministic UI fixtures are also development-only by code, even if misconfigured.
ALLOW_TEST_FIXTURES=1
SAVE_FEATURE_ENABLED=1
UPSTASH_COMMANDS_OBSERVED=0

# Generate at least 32 random bytes. Required for signed browser keys and
# deterministic idempotent deletion secrets.
APERTURE_SERVER_SECRET=

# Production persistence. Created automatically when a private Vercel Blob
# store is linked to the project.
BLOB_READ_WRITE_TOKEN=

# Optional Redis-compatible fallback. Either naming pair is supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Set after the public URL is observed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
